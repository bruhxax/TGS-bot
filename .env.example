# Required once. Everything else is configured in the Mini App admin area.
COMPOSE_PROJECT_NAME=tgs-bot-v2
TELEGRAM_BOT_TOKEN=1234567890:replace_me
PUBLIC_BASE_URL=https://tgs-bot.mooo.com
ADMIN_TELEGRAM_IDS=123456789
APP_SECRET=replace_with_a_long_random_value

# Database container defaults
POSTGRES_DB=tgsbot
POSTGRES_USER=tgsbot
POSTGRES_PASSWORD=replace_with_a_long_random_value
DATABASE_URL=postgresql://tgsbot:replace_with_a_long_random_value@db:5432/tgsbot?sslmode=disable

# Optional bootstrap values. The admin area can replace them at runtime.
REMNAWAVE_URL=
REMNAWAVE_TOKEN=
LOG_LEVEL=INFO
